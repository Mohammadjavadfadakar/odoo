<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_omnisync_auth_tree" model="ir.ui.view">
        <field name="name">omnisync.auth.profile.tree</field>
        <field name="model">omnisync.auth.profile</field>
        <field name="arch" type="xml">
            <tree string="Auth Profiles">
                <field name="name"/>
                <field name="auth_type"/>
                <field name="company_id"/>
                <field name="last_sync_status" widget="badge" options="{'bar': True}"/>
            </tree>
        </field>
    </record>

    <record id="view_omnisync_auth_form" model="ir.ui.view">
        <field name="name">omnisync.auth.profile.form</field>
        <field name="model">omnisync.auth.profile</field>
        <field name="arch" type="xml">
            <form string="Auth Profile">
                <header>
                    <button name="action_test_authentication" type="object" class="oe_highlight" string="Test" groups="omnisync.group_omnisync_admin"/>
                    <field name="active" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="auth_type"/>
                            <field name="token_endpoint" attrs="{'invisible':[('auth_type','=','api_key')]}"/>
                            <field name="client_id" attrs="{'invisible':[('auth_type','=','api_key')]}"/>
                            <field name="client_secret_masked" readonly="1" attrs="{'invisible':[('auth_type','=','api_key')]}"/>
                        </group>
                        <group>
                            <field name="description" colspan="2"/>
                            <field name="last_sync_status" readonly="1" widget="statusbar" statusbar_visible="idle,success,failed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="auth_payload" placeholder="{""api_key"": ""***""}"/>
                        </page>
                        <page string="Chatter">
                            <field name="message_follower_ids" widget="many2many_tags" readonly="1"/>
                            <field name="message_ids" widget="mail_thread" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_omnisync_auth" model="ir.actions.act_window">
        <field name="name">Auth Profiles</field>
        <field name="res_model">omnisync.auth.profile</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
