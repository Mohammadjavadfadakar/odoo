<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_omnisync_conflict_tree" model="ir.ui.view">
        <field name="name">omnisync.conflict.tree</field>
        <field name="model">omnisync.conflict</field>
        <field name="arch" type="xml">
            <list string="Conflicts" default_order="create_date desc">
                <field name="name"/>
                <field name="flow_id"/>
                <field name="model_name"/>
                <field name="state" widget="badge"/>
                <field name="resolution"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_omnisync_conflict_form" model="ir.ui.view">
        <field name="name">omnisync.conflict.form</field>
        <field name="model">omnisync.conflict</field>
        <field name="arch" type="xml">
            <form string="Conflict">
                <header>
                    <button name="action_open_resolution_wizard" type="object" string="Resolve" class="oe_highlight" modifiers="{'invisible': [('state', '!=', 'pending')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,resolved,dismissed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="flow_id" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                            <field name="record_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="resolution" readonly="1"/>
                            <field name="resolved_by" readonly="1"/>
                            <field name="resolved_on" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Differences">
                            <field name="differences_json" widget="json" readonly="1"/>
                        </page>
                        <page string="Payload">
                            <field name="external_payload" widget="json" readonly="1"/>
                        </page>
                        <page string="Candidate Values">
                            <field name="candidate_values" widget="json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_omnisync_conflict_tree" model="ir.actions.act_window">
        <field name="name">Conflicts</field>
        <field name="res_model">omnisync.conflict</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_pending":1}</field>
    </record>

    <record id="view_omnisync_queue_tree" model="ir.ui.view">
        <field name="name">omnisync.queue.message.tree</field>
        <field name="model">omnisync.queue.message</field>
        <field name="arch" type="xml">
            <list string="Queue Messages" default_order="create_date desc">
                <field name="name"/>
                <field name="system_id"/>
                <field name="topic"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_omnisync_queue_messages" model="ir.actions.act_window">
        <field name="name">Queue Buffer</field>
        <field name="res_model">omnisync.queue.message</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_omnisync_webhook_tree" model="ir.ui.view">
        <field name="name">omnisync.webhook.event.tree</field>
        <field name="model">omnisync.webhook.event</field>
        <field name="arch" type="xml">
            <list string="Webhook Events" default_order="create_date desc">
                <field name="name"/>
                <field name="system_id"/>
                <field name="event_code"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_omnisync_webhook_events" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">omnisync.webhook.event</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
