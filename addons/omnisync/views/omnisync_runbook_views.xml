<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_omnisync_runbook_form" model="ir.ui.view">
        <field name="name">omnisync.runbook.form</field>
        <field name="model">omnisync.runbook</field>
        <field name="arch" type="xml">
            <form string="Runbook">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="notify_user_id"/>
                        </group>
                        <group>
                            <field name="last_run" readonly="1"/>
                            <field name="last_status" readonly="1"/>
                            <field name="last_duration" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Runbook Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="flow_id"/>
                                    <field name="preview_mode"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Logs">
                            <field name="last_message" readonly="1" nolabel="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                <footer>
                    <button string="Execute" type="object" name="action_execute" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_omnisync_runbook_tree" model="ir.ui.view">
        <field name="name">omnisync.runbook.tree</field>
        <field name="model">omnisync.runbook</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="last_status"/>
                <field name="last_run"/>
            </list>
        </field>
    </record>

    <record id="action_omnisync_runbook" model="ir.actions.act_window">
        <field name="name">Runbooks</field>
        <field name="res_model">omnisync.runbook</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_company_id": [active_id]}</field>
    </record>

    <menuitem id="menu_omnisync_runbook" name="Runbooks" parent="menu_omnisync_configuration" action="action_omnisync_runbook" sequence="60" groups="omnisync.group_omnisync_admin"/>
</odoo>
