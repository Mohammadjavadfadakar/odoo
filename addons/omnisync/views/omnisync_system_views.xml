<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_omnisync_system_tree" model="ir.ui.view">
        <field name="name">omnisync.system.tree</field>
        <field name="model">omnisync.system</field>
        <field name="arch" type="xml">
            <list string="Systems">
                <field name="name"/>
                <field name="connector_type"/>
                <field name="base_url"/>
                <field name="company_id"/>
                <field name="last_sync_status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_omnisync_system_search" model="ir.ui.view">
        <field name="name">omnisync.system.search</field>
        <field name="model">omnisync.system</field>
        <field name="arch" type="xml">
            <search string="Search Systems">
                <field name="name"/>
                <field name="connector_type"/>
                <field name="company_id"/>
                <field name="auth_profile_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]" help="Show active systems"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_connector" string="Connector" context="{'group_by': 'connector_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_omnisync_system_form" model="ir.ui.view">
        <field name="name">omnisync.system.form</field>
        <field name="model">omnisync.system</field>
        <field name="arch" type="xml">
            <form string="Integration System">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight" groups="omnisync.group_omnisync_admin"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="alert alert-info o_form_sheet_full_width" role="status">
                        <p>
                            Define how OmniSync connects to an external platform. Provide the
                            <strong>Base URL</strong> and authentication profile, then tailor
                            connector-specific settings in the <strong>Connector Settings</strong>
                            tab. Use <strong>Test Connection</strong> to validate credentials
                            before building flows.
                        </p>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" class="oe_inline"/>
                        </h1>
                        <field name="last_sync_status" widget="badge" class="oe_inline"/>
                    </div>
                    <group>
                        <group>
                            <field name="connector_type"/>
                            <field name="base_url"/>
                            <field name="auth_profile_id" options="{'no_create': False}"/>
                            <field name="company_id"/>
                            <field name="sandbox_mode"/>
                        </group>
                        <group>
                            <field name="extra_headers_json" widget="text" class="o_text_monospaced" placeholder="{\n  &quot;Authorization&quot;: &quot;Bearer ...&quot;\n}"/>
                            <field name="default_params_json" widget="text" class="o_text_monospaced" placeholder="{\n  &quot;page&quot;: 1\n}"/>
                            <field name="notes" colspan="2"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Connector Settings">
                            <group>
                                <group>
                                    <field name="graphql_default_query" modifiers="{'invisible': [('connector_type', '!=', 'graphql')]}"/>
                                    <field name="db_engine" modifiers="{'invisible': [('connector_type', '!=', 'database')]}"/>
                                    <field name="db_host" modifiers="{'invisible': [('connector_type', '!=', 'database')]}"/>
                                    <field name="db_port" modifiers="{'invisible': [('connector_type', '!=', 'database')]}"/>
                                    <field name="db_name" modifiers="{'invisible': [('connector_type', '!=', 'database')]}"/>
                                    <field name="db_username" modifiers="{'invisible': [('connector_type', '!=', 'database')]}"/>
                                </group>
                                <group>
                                    <field name="file_backend" modifiers="{'invisible': [('connector_type', '!=', 'file')]}"/>
                                    <field name="file_base_path" modifiers="{'invisible': [('connector_type', '!=', 'file')]}"/>
                                    <field name="file_format" modifiers="{'invisible': [('connector_type', '!=', 'file')]}"/>
                                    <field name="webhook_secret" modifiers="{'invisible': [('connector_type', '!=', 'webhook')]}"/>
                                    <field name="queue_backend" modifiers="{'invisible': [('connector_type', '!=', 'queue')]}"/>
                                    <field name="queue_topic_prefix" modifiers="{'invisible': [('connector_type', '!=', 'queue')]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Flows">
                            <field name="flow_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="direction"/>
                                    <field name="schedule_mode"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_omnisync_system" model="ir.actions.act_window">
        <field name="name">Systems</field>
        <field name="res_model">omnisync.system</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_omnisync_system_search"/>
    </record>
</odoo>
