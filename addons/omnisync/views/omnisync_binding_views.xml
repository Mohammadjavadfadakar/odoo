<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_omnisync_binding_tree" model="ir.ui.view">
        <field name="name">omnisync.binding.tree</field>
        <field name="model">omnisync.binding</field>
        <field name="arch" type="xml">
            <list default_order="last_synced_at desc">
                <field name="external_identifier"/>
                <field name="flow_id"/>
                <field name="direction"/>
                <field name="model_name"/>
                <field name="record_display_name" string="Record"/>
                <field name="state"/>
                <field name="last_synced_at"/>
            </list>
        </field>
    </record>

    <record id="view_omnisync_binding_search" model="ir.ui.view">
        <field name="name">omnisync.binding.search</field>
        <field name="model">omnisync.binding</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_identifier"/>
                <field name="flow_id"/>
                <field name="direction"/>
                <field name="state"/>
                <filter name="state_failed" string="Failed" domain="[('state','=','failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_flow" string="Flow" context="{'group_by': 'flow_id'}"/>
                    <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_omnisync_binding_form" model="ir.ui.view">
        <field name="name">omnisync.binding.form</field>
        <field name="model">omnisync.binding</field>
        <field name="arch" type="xml">
            <form string="Binding">
                <header>
                    <button name="action_open_record" type="object" string="Open Record" class="oe_highlight" modifiers="{'invisible': [('model_id', '=', False)]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,synced,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="external_identifier"/>
                            <field name="flow_id"/>
                            <field name="direction"/>
                            <field name="model_id"/>
                            <field name="res_id"/>
                            <field name="record_display_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_synced_at"/>
                            <field name="last_error" widget="text" class="o_text_monospaced"/>
                            <field name="payload_snapshot_display" widget="text" class="o_text_monospaced" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_omnisync_binding" model="ir.actions.act_window">
        <field name="name">Bindings</field>
        <field name="res_model">omnisync.binding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_group_flow": 1}</field>
    </record>
</odoo>
