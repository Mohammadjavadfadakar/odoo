<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_omnisync_mapping_tree" model="ir.ui.view">
        <field name="name">omnisync.mapping.tree</field>
        <field name="model">omnisync.mapping</field>
        <field name="arch" type="xml">
            <tree string="Mappings">
                <field name="name"/>
                <field name="flow_id"/>
                <field name="target_model_id"/>
                <field name="mode"/>
            </tree>
        </field>
    </record>

    <record id="view_omnisync_mapping_form" model="ir.ui.view">
        <field name="name">omnisync.mapping.form</field>
        <field name="model">omnisync.mapping</field>
        <field name="arch" type="xml">
            <form string="Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="flow_id"/>
                            <field name="target_model_id"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="validation_domain"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="source_field"/>
                                    <field name="target_field_name"/>
                                    <field name="is_external_identifier" widget="boolean_toggle" string="External ID"/>
                                    <field name="default_value"/>
                                    <field name="transform_chain"/>
                                    <field name="relation_resolution"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_omnisync_mapping" model="ir.actions.act_window">
        <field name="name">Mappings</field>
        <field name="res_model">omnisync.mapping</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
