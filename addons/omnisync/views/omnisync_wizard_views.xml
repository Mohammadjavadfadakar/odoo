<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_omnisync_config_export_wizard" model="ir.ui.view">
        <field name="name">omnisync.config.export.wizard.form</field>
        <field name="model">omnisync.config.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Configuration">
                <group>
                    <field name="flow_ids" widget="many2many_tags"/>
                    <field name="export_format"/>
                    <field name="data_file" filename="filename" readonly="1"/>
                    <field name="filename" readonly="1"/>
                </group>
                <footer>
                    <button string="Export" name="action_export" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_omnisync_config_export" model="ir.actions.act_window">
        <field name="name">Export Configuration</field>
        <field name="res_model">omnisync.config.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_omnisync_config_export" name="Export Configuration" parent="menu_omnisync_configuration" action="action_omnisync_config_export" sequence="99" groups="omnisync.group_omnisync_admin"/>

    <record id="view_omnisync_conflict_resolution_wizard" model="ir.ui.view">
        <field name="name">omnisync.conflict.resolution.wizard.form</field>
        <field name="model">omnisync.conflict.resolution.wizard</field>
        <field name="arch" type="xml">
            <form string="Resolve Conflict">
                <group>
                    <field name="conflict_id" readonly="1"/>
                    <field name="decision"/>
                    <field name="preview" widget="json" readonly="1"/>
                </group>
                <footer>
                    <button string="Apply" name="action_resolve" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_omnisync_sandbox_preview_wizard" model="ir.ui.view">
        <field name="name">omnisync.sandbox.preview.wizard.form</field>
        <field name="model">omnisync.sandbox.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Sandbox Preview">
                <group>
                    <field name="flow_id" readonly="1"/>
                    <field name="preview_payload" widget="json" readonly="1"/>
                </group>
                <footer>
                    <button string="Refresh" name="action_preview" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_omnisync_version_promote_wizard" model="ir.ui.view">
        <field name="name">omnisync.version.promote.wizard.form</field>
        <field name="model">omnisync.version.promote.wizard</field>
        <field name="arch" type="xml">
            <form string="Promote Version">
                <group>
                    <field name="flow_id" readonly="1"/>
                    <field name="version_id"/>
                    <field name="operation"/>
                </group>
                <footer>
                    <button string="Apply" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_omnisync_template_apply_wizard" model="ir.ui.view">
        <field name="name">omnisync.template.apply.wizard.form</field>
        <field name="model">omnisync.template.apply.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Template">
                <group>
                    <field name="template_id" readonly="1"/>
                    <field name="dry_run"/>
                    <field name="result_message" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button string="Apply" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
