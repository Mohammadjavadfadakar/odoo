<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_omnisync_health_check_form" model="ir.ui.view">
        <field name="name">omnisync.health.check.form</field>
        <field name="model">omnisync.health.check</field>
        <field name="arch" type="xml">
            <form string="Health Check">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="system_id"/>
                            <field name="flow_id"/>
                        </group>
                        <group>
                            <field name="check_type"/>
                            <field name="severity"/>
                            <field name="target_endpoint" modifiers="{'invisible': [('check_type', '!=', 'connector')]}"/>
                            <field name="notify_activity_type_id"/>
                            <field name="responsible_user_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="last_run" readonly="1"/>
                            <field name="last_status" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_message" readonly="1" nolabel="1" widget="text"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Logs">
                            <field name="log_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="status"/>
                                    <field name="duration"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                <footer>
                    <button string="Run Now" type="object" name="action_run" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_omnisync_health_check_tree" model="ir.ui.view">
        <field name="name">omnisync.health.check.tree</field>
        <field name="model">omnisync.health.check</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="system_id"/>
                <field name="flow_id"/>
                <field name="check_type"/>
                <field name="last_status"/>
                <field name="last_run"/>
            </list>
        </field>
    </record>

    <record id="action_omnisync_health_check" model="ir.actions.act_window">
        <field name="name">Health Checks</field>
        <field name="res_model">omnisync.health.check</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_company_id": [id]}</field>
    </record>

</odoo>
